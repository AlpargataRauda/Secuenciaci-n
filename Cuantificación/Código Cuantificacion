#Pasar los fastq.gz a FASTA#
mkdir FASTA
for i in TrimmedAct/*fastq.gz; do   
gunzip -c "$i" | seqtk seq -a > "FASTA/$(basename "${i%.fastq.gz}.fasta")"; done


#Antes de cuantificar se debe hacer un índice con salmon de una secuencia de referencia
para que salmon pueda hacer la cuantificacion comparando con esta referencia.


#Nota: 
En Salmon, los parámetros son:

-t → input, es decir, el archivo FASTA del transcriptoma que quieres indexar

-i → output, es decir, la carpeta donde Salmon va a guardar el índice creado

Entonces aunque uses -i, no estás diciendo “input”, sino “índice de salida”.

#Crear el indice con la secuencia de referencia
salmon index -t Referencia.fasta -i Cuantificacion/Indice

#Nota: cuando no se especifica -k (numero de K-meros) salmon introduce -k 31 por defecto

Ejecutamos los siguientes códigos para todos los archhivos fastq.gz (paired)

salmon quant -i Cuantificacion/Indice/ 
-l A 
-1 TrimmedAct/HomerSimpson_R1_filtered.fastq.gz 
-2 TrimmedAct/HomerSimpson_R2_filtered.fastq.gz 
-o Cuantificacion/HomerSimpson_quantified
